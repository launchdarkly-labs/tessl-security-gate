# The agent's model + prompt live in LaunchDarkly AgentControl, so it needs an
# SDK key for the environment where targeting is on. No key, no agent.
LD_SDK_KEY=sdk-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# OpenAI key for the completion call.
OPENAI_API_KEY=sk-xxxxxxxx

# Optional — defaults to "report-summarizer-agent".
# LD_AI_CONFIG_KEY=report-summarizer-agent
